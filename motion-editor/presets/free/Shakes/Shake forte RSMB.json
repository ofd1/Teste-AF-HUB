{
  "format": "motionframe-preset@1",
  "preset": {
    "name": "Shake forte RSMB",
    "category": "Shakes",
    "anchor": "playhead",
    "transform": {},
    "effects": [
      { "type": "shake", "params": { "frequency": 18, "amount": { "keys": [{ "t": 0, "v": 90, "ease": "easeOut" }, { "t": 0.5, "v": 0, "ease": "linear" }] }, "rotation": 5, "zoom": 8 } },
      { "type": "motionBlur", "params": { "amount": 220, "samples": 16 } },
      { "type": "motionTile", "params": { "outW": 180, "outH": 180 } },
      { "type": "rgbSplit", "params": { "amount": { "keys": [{ "t": 0, "v": 18, "ease": "easeOut" }, { "t": 0.4, "v": 0, "ease": "linear" }] } } }
    ]
  }
}
