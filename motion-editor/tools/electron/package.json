{
  "name": "motionframe-desktop",
  "productName": "MotionFrame",
  "version": "1.0.0",
  "description": "MotionFrame — editor de vídeo e motion design (app de desktop, sem navegador)",
  "main": "main.cjs",
  "author": "MotionFrame",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "app.motionframe.desktop",
    "productName": "MotionFrame",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "www",
        "to": "www"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "MotionFrame.exe"
    },
    "afterPack": "./afterPack.cjs"
  }
}