{
  "name": "motionframe",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server -p 8080 -c-1 .",
    "test": "node --test tests/*.test.mjs",
    "samples": "node tests/make-samples.mjs",
    "presets": "node tools/build-presets.mjs",
    "build": "node tools/build-presets.mjs && node tools/build-www.mjs",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "version": "2.0.0",
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3"
  }
}
