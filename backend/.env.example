# Database
DATABASE_URL="postgresql://af_hub:af_hub_pass@localhost:5432/af_hub?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Anthropic AI
ANTHROPIC_API_KEY="sk-ant-..."

# MinIO / S3 Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="af-hub"
MINIO_USE_SSL=false

# Server
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# App Sandbox
SANDBOX_NETWORK="af-hub-sandbox"
SANDBOX_MEMORY_LIMIT="256m"
SANDBOX_CPU_LIMIT="0.5"
